# =============================================================================
# AI Paralegal Platform - Environment Configuration
# =============================================================================

# Application
APP_ENV=development
APP_NAME=AI Paralegal
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
# PostgreSQL + pgvector (Docker Compose default)
DATABASE_URL=postgresql+asyncpg://paralegal:paralegal@postgres:5432/ai_paralegal
# Local SQLite quickstart option (no Docker required):
# DATABASE_URL=sqlite+aiosqlite:///./ai_paralegal.db

# Redis & Celery Background Execution
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Execution mode: "celery" (Docker/worker), "inline" (synchronous/tests), "background" (FastAPI tasks)
TASK_EXECUTION_MODE=inline

# Object / File Storage
# "local" or "s3"
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# LLM Routing & Grounding Controls
# "mock" (offline deterministic), "ollama", or "gemini"
LLM_DEFAULT_PROVIDER=mock
LLM_FALLBACK_PROVIDERS=ollama,gemini,mock
LLM_CONFIDENCE_THRESHOLD=0.75
LLM_GROUNDING_THRESHOLD=0.70
LLM_ESCALATE_HIGH_RISK=true
LLM_REQUEST_TIMEOUT_SECONDS=90

# Local Ollama (Open-Weight Models)
# Supported aliases include: llama-3.1-8b-instruct, qwen-2.5-7b-instruct,
# mistral-nemo-12b, deepseek-r1-distill-qwen-8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama-3.1-8b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Cloud Gemini API
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Embeddings
# "deterministic" (offline hash-projection), "ollama", or "gemini"
EMBEDDING_PROVIDER=deterministic
EMBEDDING_DIMENSIONS=384

# Authentication & RBAC
# IMPORTANT: Override AUTH_SECRET_KEY in production with a strong random 32+ byte secret.
AUTH_SECRET_KEY=dev-insecure-secret-change-in-production-32bytes
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=14
AUTH_AUTO_SEED_DEMO_USERS=true
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
OIDC_ROLE_CLAIM=groups
OIDC_ROLE_MAPPING_JSON={"legal-partners":"partner","legal-associates":"associate","legal-paralegals":"paralegal","legal-auditors":"auditor"}
DEFAULT_ORGANIZATION_SLUG=default-firm
DEFAULT_ORGANIZATION_NAME=Meridian Legal Group LLP

# S3 Server-Side Encryption (AES256 or aws:kms when S3_KMS_KEY_ID set)
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=

# Upload Hardening, Webhooks & Outbound Cloud Guardrails
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.md,.eml,.vtt,.srt
LLM_REDACT_PII_FOR_CLOUD=true
LLM_BLOCK_PRIVILEGED_FOR_CLOUD=true
LLM_TASK_ROUTING_JSON=
WEBHOOK_ALLOW_PRIVATE_IPS=false

# Distributed Backplanes, Rate Limiting & Observability
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_AUTH_PER_MINUTE=120
RATE_LIMIT_LLM_PER_MINUTE=120
EVENT_BUS_BACKEND=memory
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-paralegal-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATIO=1.0
RETENTION_SWEEP_ENABLED=true
RETENTION_SWEEP_INTERVAL_HOURS=24

# OCR & Scanned PDF Pipeline
# "auto" (uses tesseract when available), "tesseract", "mock", or "disabled"
OCR_BACKEND=auto
OCR_MIN_CHARS_PER_PAGE=20
